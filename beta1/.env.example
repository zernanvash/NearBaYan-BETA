NODE_ENV=development
PORT=5000

# Development uses LOCAL_MONGO_URI by default unless USE_REMOTE_MONGO=true.
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/nearBaYan
MONGO_URI=mongodb://127.0.0.1:27017/nearBaYan
USE_REMOTE_MONGO=false
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
# Optional list for multiple frontends (comma-separated), e.g. web + mobile-hosted preview
CLIENT_URLS=http://localhost:3000,http://localhost:3003

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nearBaYan-uploads
AWS_REGION=ap-southeast-1

FIREBASE_SERVER_KEY=

OPENAI_API_KEY=
